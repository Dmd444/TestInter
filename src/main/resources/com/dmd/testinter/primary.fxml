<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dmd.testinter.PrimaryController">
    <children>
        <Label text="La Liebre y la Tortuga" />
        <Button fx:id="btnIniciar" text="¡Iniciar Carrera!" onAction="#iniciarCarrera" />
        <Label fx:id="lblLiebre" text="La Liebre: Esperando..." />
        <ProgressBar fx:id="barLiebre" progress="0.0" prefWidth="350.0" />
        <Label fx:id="lblTortuga" text="La Tortuga: Esperando..." />
        <ProgressBar fx:id="barTortuga" progress="0.0" prefWidth="350.0" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>